# Server Configuration
PORT=3000
HOST=127.0.0.1

# OAuth 2.0 Credentials (Set these for Google Gemini / Remote MCP Client)
OAUTH_CLIENT_ID=omada_gemini_client_id_change_me
OAUTH_CLIENT_SECRET=super_secret_key_change_me_12345
JWT_SECRET=random_jwt_signing_secret_change_me_67890

# TP-Link Omada Fusion 2.5G Gateway Credentials
OMADA_URL=https://192.168.1.1:8043
OMADA_USERNAME=admin
OMADA_PASSWORD=your_omada_password
OMADA_SITE=Default
OMADA_ALLOW_UNAUTHORIZED_CERTS=true

# Security Mode (Set to true for read-only operation)
OMADA_READ_ONLY=true
